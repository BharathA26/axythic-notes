{
  "manifest_version": 3,
  "name": "Axythic Note",
  "version": "1.0.0",
  "description": "Capture transcripts seamlessly directly inside Google Meet.",
  "permissions": ["storage", "activeTab", "tabs", "scripting", "identity"],
  "host_permissions": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Axythic Note"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*"],
      "js": ["src/content/index.tsx"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
