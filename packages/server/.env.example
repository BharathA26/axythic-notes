# Server
PORT=5002
NODE_ENV=development

# MongoDB (Atlas: mongodb+srv://... | Local: mongodb://localhost:27017/axythic)
MONGODB_URI=mongodb://localhost:27017/axythic

# Firebase Admin — used only for verifying JWT tokens
# Get from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# OpenAI
OPENAI_API_KEY=

# Email (SMTP) — optional, leave blank to skip email sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
